#!/usr/bin/env bash
# После git merge/pull: upstream мог вернуть .claude/hooks в settings — чиним для Cursor.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
SCRIPT="$ROOT/scripts/run-post-update-cursor-normalize.sh"
[ ! -f "$SCRIPT" ] && exit 0
echo "[post-merge] IWE: нормализация Claude settings под Cursor..."
SCRIPT_DIR="$ROOT" WORKSPACE_DIR="$(dirname "$ROOT")" bash "$SCRIPT" || true
