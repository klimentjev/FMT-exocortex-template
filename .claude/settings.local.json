{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git init:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(launchctl load:*)",
      "Bash(launchctl unload:*)",
      "Bash(launchctl list:*)",
      "Bash(claude:*)",
      "mcp__knowledge-mcp__search",
      "mcp__knowledge-mcp__get_document",
      "mcp__knowledge-mcp__list_sources",
      "mcp__ddt__describe_by_path",
      "mcp__ddt__read_digital_twin",
      "mcp__ddt__write_digital_twin"
    ]
  },
  "mcpServers": {
    "knowledge-mcp": {
      "type": "url",
      "url": "https://knowledge-mcp.aisystant.workers.dev/mcp"
    },
    "ddt": {
      "type": "url",
      "url": "https://digital-twin-mcp.aisystant.workers.dev/mcp"
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh wp-gate-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh close-gate-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh extensions-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh protocol-artifact-validate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh capture-bus.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh dry-run-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh protocol-completion-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh protocol-stop-gate.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh capture-bus.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-claude-hook.sh precompact-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
